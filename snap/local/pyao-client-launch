#!/bin/sh
set -eu
: "${SNAP:?Debe ejecutarse desde el paquete Snap}"
: "${SNAP_USER_COMMON:?Falta el directorio de usuario del Snap}"
umask 077
export XDG_DATA_HOME="$SNAP_USER_COMMON/data"
export XDG_CONFIG_HOME="$SNAP_USER_COMMON/config"
export XDG_CACHE_HOME="$SNAP_USER_COMMON/cache"
mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME"
cd "$SNAP"
exec "$SNAP/bin/pyao-client" --rendering-method gl_compatibility --display-driver x11 "$@"
