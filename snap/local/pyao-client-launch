#!/bin/sh
set -eu
: "${SNAP:?Debe ejecutarse desde el paquete Snap}"
: "${SNAP_USER_COMMON:?Falta el directorio de usuario del Snap}"
umask 077
export XDG_DATA_HOME="$SNAP_USER_COMMON/data"
export XDG_CONFIG_HOME="$SNAP_USER_COMMON/config"
export XDG_CACHE_HOME="$SNAP_USER_COMMON/cache"
export XKB_CONFIG_ROOT="$SNAP/usr/share/X11/xkb"
export ALSA_CONFIG_DIR="$SNAP/usr/share/alsa"
export ALSA_CONFIG_PATH="$SNAP/usr/share/alsa/alsa.conf"
case "${SNAP_ARCH:?Falta la arquitectura del Snap}" in
    amd64) pyao_multiarch=x86_64-linux-gnu ;;
    arm64) pyao_multiarch=aarch64-linux-gnu ;;
    *) echo "Arquitectura del Snap no soportada: $SNAP_ARCH" >&2; exit 1 ;;
esac
export LD_LIBRARY_PATH="$SNAP/usr/lib/$pyao_multiarch/pulseaudio${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
pyao_runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
pyao_runtime_dir=${pyao_runtime_dir%/snap.*}
export PULSE_SERVER="${PULSE_SERVER:-unix:$pyao_runtime_dir/pulse/native}"
mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME"
cd "$SNAP"
exec "$SNAP/bin/pyao-client" --rendering-method gl_compatibility --display-driver x11 "$@"
